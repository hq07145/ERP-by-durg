# ==========================================
# Root .gitignore — ERP Secrets & Handover Protection
# ==========================================

# Environment variables and private credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
!.env.example
!app/.env.example

# Local secrets, keys, and certificates
*.pem
*.key
*.cert
*.pfx
*.p12

# Python virtual environments (never commit virtualenv)
.venv/
venv/
env/
__pycache__/
*.pyc

# Node & Next.js dependencies and build output
node_modules/
app/node_modules/
.next/
app/.next/
out/
app/out/
build/
app/build/
dist/
app/dist/
.vercel
app/.vercel

# Scratch, test scripts, and local developer artifacts
app/scratch/
scratch/
app/scripts/
scripts/*.cjs
scripts/*.json
app/orders_backup_*.json
*.jsonl
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database backup dumps containing production/testing snapshots
scripts/backups/
app/scripts/backups/
*.dump
*.sql.bak

# Operating System files
.DS_Store
Thumbs.db

# Supabase local temp files
app/supabase/.temp/
app/supabase/setup_*.sql
